    "test": "bun test --timeout 600000"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
