{
  "name": "ai-router-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for the ai-router proxy, consumed as TypeScript source.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json",
